# Copy this file to .env and fill in values before running locally.
# Never commit .env — it is in .gitignore.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=tp
POSTGRES_PASSWORD=tp
POSTGRES_DB=transparentpolitics
# Async URL used by SQLAlchemy in the backend
DATABASE_URL=postgresql+asyncpg://tp:tp@localhost:5432/transparentpolitics

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ROOT_USER=tp_admin
MINIO_ROOT_PASSWORD=tp_secret
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_RAW=raw-ingest

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ── Data source API keys ──────────────────────────────────────────────────────
# Congress.gov  →  https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=

# OpenFEC  →  https://api.open.fec.gov/developers/
OPENFEC_API_KEY=

# CIV.IQ  →  https://civdotiq.org  (no key required; left here for documentation)
# CIVIQ_BASE_URL=https://civdotiq.org
